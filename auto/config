#!/bin/sh
set -e
lb config noauto \
  --distribution trixie \
  --architectures amd64 \
  --binary-image iso-hybrid \
  --image-name sventos-live \
  --bootloaders "grub-pc grub-efi" \
  --chroot-squashfs-compression-type gzip \
  --archive-areas "main contrib non-free non-free-firmware" \
  --debootstrap-options "--variant=minbase --include=ca-certificates" \
  --apt-recommends false \
  --firmware-chroot false \
  --debian-installer none \
  --win32-loader false \
  --memtest none \
  --bootappend-live "boot=live components quiet noeject hostname=sventos username=svent-live locales=en_US.UTF-8 keyboard-layouts=us live-config.user-default-groups=audio,video,plugdev,netdev,sudo" \
  --iso-application "SventOS" \
  --iso-volume "SventOS Live" \
  --iso-publisher "z1rov" \
  "${@}"
