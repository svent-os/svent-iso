#!/bin/sh
set -eu
for package in svent-core svent-artwork svent-xfce firefox-esr sv-firefox-config lxdm dbus-user-session libglib2.0-bin calamares; do
    test "$(dpkg-query -W -f='${Status}' "$package")" = 'install ok installed'
done
for command in startxfce4 xfwm4 xfdesktop xfce4-panel gio calamares; do
    command -v "$command" >/dev/null
done
test -f /usr/lib/systemd/user/dbus.service
if ! id svent-live >/dev/null 2>&1; then
    useradd --create-home --shell /bin/zsh --groups audio,video,plugdev,netdev,sudo svent-live
fi
printf '%s\n' 'svent-live:live' | chpasswd
cp -a /etc/skel/. /home/svent-live/
test -s /usr/share/svent/logo/logo.png
cp /usr/share/svent/logo/logo.png /etc/calamares/branding/svent/logo.png
mkdir -p /home/svent-live/Desktop
install -m 0755 /usr/share/applications/svent-install.desktop /home/svent-live/Desktop/svent-install.desktop
chmod 0755 /usr/libexec/svent/prepare-install-launcher
chmod 0755 /usr/local/bin/svent-install
desktop-file-validate /usr/share/applications/svent-install.desktop
desktop-file-validate /etc/skel/.config/autostart/svent-install-launcher.desktop
python3 - <<'PY'
import ast
import json
from pathlib import Path
import yaml
config = Path('/etc/calamares')
for path in config.rglob('*'):
    if path.suffix in ('.conf', '.desc'):
        yaml.safe_load(path.read_text())
for name in ['welcome', 'locale', 'keyboard', 'packagechooser', 'netinstall', 'partition', 'users', 'summary', 'mount', 'unpackfs', 'machineid', 'fstab', 'localecfg', 'hwclock', 'grubcfg', 'bootloader', 'umount', 'finished']:
    assert any((Path(folder) / name / 'module.desc').is_file() for folder in ['/usr/lib/x86_64-linux-gnu/calamares/modules', '/usr/lib/calamares/modules']), name
for path in [Path('/usr/local/bin/svent-install'), config / 'modules/sventinstall/main.py']:
    ast.parse(path.read_text())
json.loads(Path('/usr/share/svent/installer/descriptions.json').read_text())
for name in ['welcome-image.png', 'installation-image.png', 'show.qml']:
    assert (config / 'branding/svent' / name).is_file(), name
PY
python3 - <<'PY'
from pathlib import Path
import configparser
import io
import xml.etree.ElementTree as ET
home = Path('/home/svent-live')
config = home / '.config/xfce4/xfconf/xfce-perchannel-xml'
config.mkdir(parents=True, exist_ok=True)
def update(channel, values):
    path = config / (channel + '.xml')
    tree = ET.parse(path) if path.exists() else ET.ElementTree(ET.Element('channel', name=channel, version='1.0'))
    for name, kind, value in values:
        parent = tree.getroot()
        parts = name.split('/')
        for part in parts[:-1]:
            child = parent.find("property[@name='" + part + "']")
            if child is None:
                child = ET.SubElement(parent, 'property', name=part, type='empty')
            parent = child
        node = parent.find("property[@name='" + parts[-1] + "']")
        if node is None:
            node = ET.SubElement(parent, 'property', name=parts[-1])
        node.set('type', kind)
        node.set('value', value)
    ET.indent(tree)
    tree.write(path, encoding='utf-8', xml_declaration=True)
update('xfwm4', [('general/use_compositing', 'bool', 'false')])
update('xfce4-power-manager', [("xfce4-power-manager/" + name, kind, value) for name, kind, value in [('dpms-enabled','bool','false'),('inactivity-on-ac','uint','0'),('inactivity-on-battery','uint','0'),('lock-screen-suspend-hibernate','bool','false')]])
autostart = home / '.config/autostart'
autostart.mkdir(parents=True, exist_ok=True)
for name in ['xfce4-screensaver', 'light-locker']:
    (autostart / (name + '.desktop')).write_text('[Desktop Entry]\nType=Application\nHidden=true\n')
path = Path('/etc/lxdm/lxdm.conf')
settings = configparser.ConfigParser(interpolation=None, strict=False)
settings.read(path)
if not settings.has_section('base'):
    settings.add_section('base')
settings.set('base', 'autologin', 'svent-live')
settings.set('base', 'session', '/usr/bin/startxfce4')
out = io.StringIO()
settings.write(out)
path.write_text(out.getvalue())
PY
chown -R svent-live:svent-live /home/svent-live
printf '%s\n' 'svent-live ALL=(ALL) NOPASSWD: ALL' > /etc/sudoers.d/svent-live
chmod 0440 /etc/sudoers.d/svent-live
visudo -cf /etc/sudoers.d/svent-live
mkdir -p /etc/systemd/system/lxdm.service.d /etc/systemd/logind.conf.d /etc/live/config.conf.d
printf '[Unit]\nAfter=live-config.service\n' > /etc/systemd/system/lxdm.service.d/10-live.conf
printf '[Login]\nIdleAction=ignore\nHandleLidSwitch=ignore\nHandleLidSwitchExternalPower=ignore\nHandleLidSwitchDocked=ignore\n' > /etc/systemd/logind.conf.d/10-live.conf
printf 'LIVE_USERNAME="svent-live"\nLIVE_USER_FULLNAME="SventOS Live"\nLIVE_X_SESSION_MANAGER="/usr/bin/startxfce4"\n' > /etc/live/config.conf.d/10-svent.conf
printf '/usr/sbin/lxdm\n' > /etc/X11/default-display-manager
ln -sfn /usr/bin/startxfce4 /etc/alternatives/x-session-manager
systemctl enable lxdm.service
systemctl set-default graphical.target
for target in sleep.target suspend.target hibernate.target hybrid-sleep.target suspend-then-hibernate.target; do
    systemctl mask "$target"
done
mkdir -p /home/svent-live/.config/autostart
printf '[Desktop Entry]\nType=Application\nName=Live Display Settings\nExec=sh -c "xset s off; xset -dpms"\nOnlyShowIn=XFCE;\n' > /home/svent-live/.config/autostart/live-display.desktop
chown svent-live:svent-live /home/svent-live/.config/autostart/live-display.desktop
test -L /etc/systemd/system/display-manager.service
test -x /etc/skel/.config/xfce4/xinitrc
mkdir -p /etc/modprobe.d /etc/systemd/system/run-live-medium.mount.d
cat > /etc/modprobe.d/svent-vmware-smbus.conf <<'EOF'
install i2c_piix4 /bin/sh -c 'if [ "$(cat /sys/class/dmi/id/sys_vendor 2>/dev/null)" != "VMware, Inc." ]; then exec /sbin/modprobe --ignore-install i2c_piix4; fi'
EOF
printf '[Unit]\nDefaultDependencies=no\n' > /etc/systemd/system/run-live-medium.mount.d/10-live-shutdown.conf
chmod 0755 /usr/libexec/svent/prepare-live-shutdown
systemctl enable svent-live-shutdown.service
test -x /usr/lib/systemd/systemd-shutdown
update-initramfs -u -k all
ldconfig
