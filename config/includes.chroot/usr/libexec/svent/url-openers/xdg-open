#!/usr/bin/python3
import os
import pwd
import sys
from urllib.parse import urlsplit


def browser_command(url):
    parsed = urlsplit(url)
    if parsed.scheme not in ('http', 'https') or not parsed.hostname:
        raise ValueError('Only HTTP and HTTPS links are supported.')
    browser = ['/usr/bin/firefox-esr', '--new-tab', url]
    if os.geteuid() != 0:
        return browser
    account = pwd.getpwnam('svent-live')
    if account.pw_uid == 0:
        raise RuntimeError('The live browser user must not be root.')
    runtime = '/run/user/' + str(account.pw_uid)
    environment = [
        'HOME=' + account.pw_dir,
        'USER=' + account.pw_name,
        'LOGNAME=' + account.pw_name,
        'XDG_RUNTIME_DIR=' + runtime,
        'DBUS_SESSION_BUS_ADDRESS=unix:path=' + runtime + '/bus',
        'DISPLAY=' + os.environ.get('DISPLAY', ':0'),
        'XAUTHORITY=' + os.environ.get('XAUTHORITY', account.pw_dir + '/.Xauthority')]
    return ['/usr/sbin/runuser', '-u', account.pw_name, '--', '/usr/bin/env', *environment, *browser]


if __name__ == '__main__':
    if len(sys.argv) != 2:
        raise SystemExit('Usage: xdg-open URL')
    command = browser_command(sys.argv[1])
    os.execv(command[0], command)
