#!/usr/bin/python3
import json
import os
from pathlib import Path
import re
import subprocess
import sys

import yaml


CATEGORIES = [
    ('active-directory', 'Active Directory Tools', 'Directory services, authentication and Windows domain assessment.'),
    ('recon', 'Recon Tools', 'Discover hosts, services, domains and exposed information.'),
    ('web', 'Web Tools', 'Inspect and test web applications, APIs and HTTP services.'),
    ('network', 'Network Tools', 'Analyze traffic, inspect protocols and create network tunnels.'),
    ('password-audit', 'Password Audit Tools', 'Identify hashes, audit credentials and manage wordlists.'),
    ('c2', 'C2 Frameworks', 'Operator clients, teamservers and command and control platforms.'),
    ('exploitation', 'Exploitation Tools', 'Exploit research, framework runtimes and payload development.')]
BASE = [
    ('openvpn', 'OpenVPN', 'Connect to VPN networks.'),
    ('network-manager-openvpn-gnome', 'VPN Settings', 'Manage OpenVPN connections from the desktop.'),
    ('tree', 'Tree', 'Display directory structures.'),
    ('plocate', 'Locate', 'Find files using a local search index.'),
    ('git', 'Git', 'Manage source repositories.'),
    ('openssh-client', 'SSH Client', 'Connect securely to remote systems.'),
    ('curl', 'Curl', 'Transfer data from command-line requests.'),
    ('wget', 'Wget', 'Download files and website content.'),
    ('jq', 'JQ', 'Process JSON from the command line.'),
    ('ripgrep', 'Ripgrep', 'Search text and source files.'),
    ('tmux', 'Tmux', 'Keep multiple terminal sessions organized.'),
    ('rsync', 'Rsync', 'Copy and synchronize files.'),
    ('unzip', 'Unzip', 'Extract ZIP archives.'),
    ('7zip', '7 Zip', 'Create and extract compressed archives.'),
    ('keepassxc', 'KeePassXC', 'Store credentials in a local password database.'),
    ('remmina', 'Remmina', 'Connect to remote desktops.'),
    ('meld', 'Meld', 'Compare files and directories.'),
    ('libreoffice-writer', 'LibreOffice Writer', 'Edit documents.'),
    ('libreoffice-calc', 'LibreOffice Calc', 'Work with spreadsheets.'),
    ('obsidian', 'Obsidian', 'Organize local notes. Downloaded from the official release during installation.')]
MANDATORY = ['linux-image-amd64', 'svent-core', 'svent-artwork', 'firefox-esr', 'sv-firefox-config', 'network-manager', 'ca-certificates', 'locales', 'keyboard-configuration', 'console-setup', 'dbus-user-session', 'sudo', 'zsh', 'cryptsetup-initramfs']


def candidate(cache, name):
    if name not in cache or cache[name].candidate is None:
        raise RuntimeError('A required package is unavailable: ' + name)
    return cache[name].candidate


def tool_members(cache, name):
    version = candidate(cache, name)
    tools = []
    for group in version.dependencies:
        if group.rawtype not in ('Depends', 'PreDepends'):
            continue
        choices = [dependency.name for dependency in group.or_dependencies]
        relevant = [item for item in choices if item.startswith('sv-') and item not in ('sv-firefox-config', 'sv-icon-theme')]
        if not relevant:
            continue
        selected = None
        for dependency in group.or_dependencies:
            item = dependency.name
            if item not in relevant or item not in cache or cache[item].candidate is None:
                continue
            if getattr(dependency, 'version', ''):
                import apt_pkg
                if not apt_pkg.check_dep(cache[item].candidate.version, dependency.relation, dependency.version):
                    continue
            selected = item
            break
        if selected is None:
            raise RuntimeError(name + ' depends on an unavailable tool: ' + ' or '.join(relevant))
        tools.append(selected)
    if not tools:
        raise RuntimeError('No published tools were found for ' + name)
    return sorted(set(tools))


def virtualization(kind, available):
    profiles = {
        'vmware': (['open-vm-tools'], ['open-vm-tools-desktop'], ['open-vm-tools.service']),
        'kvm': (['qemu-guest-agent'], ['spice-vdagent'], ['qemu-guest-agent.service']),
        'qemu': (['qemu-guest-agent'], ['spice-vdagent'], ['qemu-guest-agent.service']),
        'oracle': (['virtualbox-guest-utils'], ['virtualbox-guest-x11'], []),
        'microsoft': (['hyperv-daemons'], [], [])}
    service, desktop, units = profiles.get(kind, ([], [], []))
    return {'kind': kind, 'packages': [p for p in service if available(p)], 'desktop_packages': [p for p in desktop if available(p)], 'services': units if all(available(p) for p in service) else []}


def categories(cache):
    result = list(CATEGORIES)
    known = {'sv-tools-' + category for category, _, _ in result}
    for name in sorted(cache.keys()):
        if not name.startswith('sv-tools-') or name in known or cache[name].candidate is None:
            continue
        version = cache[name].candidate
        if any(dependency.name.startswith('sv-tools-') for group in version.dependencies for dependency in group.or_dependencies):
            continue
        category = name.removeprefix('sv-tools-')
        title = category.replace('-', ' ').title() + ' Tools'
        description = getattr(version, 'summary', 'Published tools for this category.')
        result.append((category, title, description))
    return result


def generate(cache, descriptions, vm):
    for name in MANDATORY + ['svent-xfce', 'svent-bspwm', 'svent-login', 'svent-boot', 'grub-pc', 'grub-efi-amd64', 'efibootmgr']:
        candidate(cache, name)
    groups = [{'name': 'System Base', 'hidden': True, 'selected': True, 'immutable': True, 'critical': True, 'packages': MANDATORY}]
    base = []
    for package, name, description in BASE:
        if package != 'obsidian':
            candidate(cache, package)
        base.append(tool_item(package, name, description, True))
    groups.append({'name': 'Desktop Base', 'description': 'Everyday applications, VPN and command-line utilities.', 'selected': True, 'critical': True, 'subgroups': base})
    metadata = {'mandatory': MANDATORY, 'base': [p for p, _, _ in BASE], 'categories': {}, 'virtualization': vm}
    for category, title, description in categories(cache):
        meta = 'sv-tools-' + category
        members = tool_members(cache, meta)
        metadata['categories'][meta] = members
        items = []
        for package in members:
            version = candidate(cache, package)
            data = descriptions.get(package, {})
            summary = re.sub(r'^Svent\s+.*?\btool:\s*', '', version.summary, flags=re.I)
            items.append(tool_item(package, data.get('name', package.removeprefix('sv-')), data.get('description', summary), False))
        groups.append({'name': title, 'description': description, 'selected': False, 'critical': True, 'subgroups': items})
    return groups, metadata


def tool_item(package, name, description, selected):
    return {'name': name, 'description': description, 'selected': selected,
            'subgroups': [{'name': package, 'hidden': True, 'selected': True, 'packages': [package]}]}


def main():
    if os.geteuid() != 0:
        os.execvp('sudo', ['sudo', '-n', sys.argv[0], *sys.argv[1:]])
    if not Path('/run/live/medium').is_dir():
        raise RuntimeError('Start this installer from the SventOS Live system.')
    import fcntl
    lock = Path('/run/svent-installer.lock').open('w')
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        subprocess.run(['zenity', '--info', '--title=SventOS Installer', '--text=The installer is already running.'], check=False)
        return 0
    progress = subprocess.Popen(['zenity', '--progress', '--pulsate', '--auto-close', '--no-cancel', '--title=SventOS Installer', '--text=Refreshing the signed package catalog...'], stdin=subprocess.PIPE, text=True)
    try:
        folder = Path('/run/svent-installer')
        folder.mkdir(mode=0o755, exist_ok=True)
        with Path('/var/log/svent-installer-prepare.log').open('w') as log:
            subprocess.run(['apt-get', 'update', '--error-on=any', '-o', 'Acquire::Retries=2', '-o', 'Acquire::http::Timeout=20', '-o', 'Acquire::https::Timeout=20'], check=True, stdout=log, stderr=subprocess.STDOUT, timeout=180)
        import apt
        cache = apt.Cache()
        result = subprocess.run(['systemd-detect-virt', '--vm'], capture_output=True, text=True, check=False)
        vm = virtualization(result.stdout.strip() if result.returncode == 0 else 'none', lambda name: name in cache and cache[name].candidate is not None)
        descriptions = json.loads(Path('/usr/share/svent/installer/descriptions.json').read_text())
        groups, metadata = generate(cache, descriptions, vm)
        (folder / 'packages.yaml').write_text(yaml.safe_dump(groups, sort_keys=False))
        (folder / 'metadata.json').write_text(json.dumps(metadata, indent=2) + '\n')
    except Exception as error:
        progress.terminate()
        progress.wait()
        subprocess.run(['zenity', '--error', '--title=SventOS Installer', '--text=The online installer could not prepare its package catalog.\n\n' + str(error) + '\n\nLog: /var/log/svent-installer-prepare.log'], check=False)
        return 1
    progress.terminate()
    progress.wait()
    os.environ['QT_QPA_PLATFORM'] = 'xcb'
    os.environ['QT_QUICK_BACKEND'] = 'software'
    os.environ['PATH'] = '/usr/libexec/svent/url-openers:' + os.environ.get('PATH', '/usr/sbin:/usr/bin:/sbin:/bin')
    with Path('/var/log/svent-calamares.log').open('w') as log:
        return subprocess.call(['/usr/bin/calamares', '-style', 'fusion'], stdout=log, stderr=subprocess.STDOUT)


if __name__ == '__main__':
    sys.exit(main())
